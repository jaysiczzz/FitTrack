# Server Port & Environment
PORT=3000
NODE_ENV=development

# Neon PostgreSQL Database Connections
# DATABASE_URL: Pooled connection string for Prisma Client runtime queries
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: Direct unpooled connection string for Prisma schema migrations
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication (generate a secure random 32+ character string)
JWT_SECRET="replace-with-a-secure-random-32-character-secret"

# Google Gemini AI API Key (required for AI Coach & nutrition scanning)
GEMINI_API_KEY=""

# Frontend Origin for CORS (comma-separated in production)
CLIENT_ORIGIN="http://localhost:8081,http://localhost:3000"

# SMTP Email Delivery (Gmail App Password or SMTP provider)
# Required in production for password reset OTP emails
SMTP_USER="fittrack.app.help@gmail.com"
SMTP_PASS=""

# PayMongo PH Payments (GCash, Maya, GrabPay)
PAYMONGO_SECRET_KEY=""

# Stripe Card Payments (optional / fallback)
STRIPE_SECRET_KEY=""
