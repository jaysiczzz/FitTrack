# FitTrack Server Environment Variables
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@host/neondb?sslmode=require"
JWT_SECRET="your-jwt-secret-here"
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.1-flash-lite"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
PORT=3000

# Payment Gateways (Stripe & PayMongo)
# 1. Stripe (Card, International & Philippine Debit/Credit)
# Sign up free at stripe.com to get your test keys (sk_test_...) or live keys (sk_live_...)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# 2. PayMongo (Philippines: GCash, Maya, GrabPay)
# Sign up free at paymongo.com to get your test keys (sk_test_...) or live keys (sk_live_...)
PAYMONGO_SECRET_KEY=""
PAYMONGO_PUBLIC_KEY=""
