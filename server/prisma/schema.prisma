generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  height    Int?     // cm
  weight    Int?     // kg
  age       Int?
  goal      Goal?
  createdAt DateTime @default(now())
}

enum Goal {
  MUSCLE_GAIN
  WEIGHT_LOSS
}