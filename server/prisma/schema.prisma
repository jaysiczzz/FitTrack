generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  password        String
  firstName       String
  lastName        String
  role            Role             @default(USER)
  height          Int              // cm
  weight          Float            // kg
  targetWeight    Float?           // kg
  age             Int
  goal            Goal
  createdAt       DateTime         @default(now())
  workoutSessions WorkoutSession[]
  dailyFoodLogs   DailyFoodLog[]
  customExercises Exercise[]
  customFoods     Food[]
  refreshTokens   RefreshToken[]
  testimonials    Testimonial[]
  testimonialVotes TestimonialVote[]
  dailyCheckIns   DailyCheckIn[]
  notificationPreference NotificationPreference?
  aiChatMessages  AiChatMessage[]
  workoutPlan     WorkoutPlan?
  weightLogs      WeightLog[]
  subscription    Subscription?
  wallet          Wallet?
  walletTransactions WalletTransaction[]
}

enum Goal {
  MUSCLE_GAIN
  WEIGHT_LOSS
}

enum Role {
  USER
  ADMIN
}

model Exercise {
  id                       String   @id @default(uuid())
  name                     String
  description              String?
  category                 String   @default("Strength")
  type                     String   @default("Compound")
  difficulty               String   @default("Beginner")
  primaryMuscle            String   @default("Chest")
  muscleGroup              String   @default("Chest")
  secondaryMuscles         Json?
  bodyPart                 String   @default("Upper Body")
  equipment                Json?
  equipmentAlternatives    Json?
  startingPosition         String?
  instructions             Json?
  formTips                 Json?
  commonMistakes           Json?
  breathingTechnique       String?
  recommendedSets          Int?
  recommendedReps          Int?
  recommendedDuration      Int?
  recommendedRest          Int?
  recommendedTempo         String?
  defaultSets              Json?
  imageUrl                 String?
  thumbnailUrl             String?
  gifUrl                   String?
  videoUrl                 String?
  safetyInstructions       String?
  injuryPreventionTips     String?
  beginnerModification     String?
  advancedVariation        String?
  easierAlternative        String?
  harderAlternative        String?
  equipmentFreeAlternative String?
  similarExercises         Json?
  tags                     Json?
  difficultyPresets        Json?
  isSystem                 Boolean  @default(true)
  userId                   String?
  user                     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt

  @@index([name])
  @@index([userId])
  @@index([muscleGroup])
}

model WorkoutSession {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  duration       Int               @default(0) // minutes
  caloriesBurned Int               @default(0)
  completed      Boolean           @default(false)
  startedAt      DateTime          @default(now())
  completedAt    DateTime?
  exercises      WorkoutExercise[]
  createdAt      DateTime          @default(now())
}

model WorkoutExercise {
  id               String         @id @default(uuid())
  workoutSessionId String
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exerciseId       String?
  name             String
  category         String?
  type             String?
  sets             ExerciseSet[]
}

model ExerciseSet {
  id                String          @id @default(uuid())
  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  setNumber         Int
  weight            Float?
  reps              Int?
  bodyweight        Boolean         @default(false)
  done              Boolean         @default(false)
}

model DailyFoodLog {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          String        // "YYYY-MM-DD" e.g. "2026-08-24"
  totalCalories Int           @default(0)
  totalProtein  Float         @default(0)
  totalCarbs    Float         @default(0)
  totalFat      Float         @default(0)
  waterMl       Int           @default(0)
  isCompleted   Boolean       @default(false)
  completedAt   DateTime?
  meals         FoodLogMeal[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([userId, date])
}

model FoodLogMeal {
  id             String       @id @default(uuid())
  dailyFoodLogId String
  dailyFoodLog   DailyFoodLog @relation(fields: [dailyFoodLogId], references: [id], onDelete: Cascade)
  mealType       String       // "breakfast" | "lunch" | "dinner" | "snack"
  title          String
  subtitle       String?
  calories       Int          @default(0)
  protein        Float        @default(0)
  carbs          Float        @default(0)
  fat            Float        @default(0)
  goalBadge      String?
  goalBadgeColor String?
  icon           String?
  healthNotes    String?
  imageUri       String?
  loggedAt       String?
  createdAt      DateTime     @default(now())
}

model Food {
  id             String     @id @default(uuid())
  name           String
  brand          String?
  barcode        String?    @unique
  category       String?    @default("Staples")
  servingSize    String     @default("100g")
  servingWeightG Float      @default(100)
  servingUnit    String     @default("g")
  calories       Int        @default(0)
  protein        Float      @default(0)
  carbs          Float      @default(0)
  fat            Float      @default(0)
  fiber          Float?
  description    String?
  ingredients    String?
  icon           String?
  imageUrl       String?
  isVerified     Boolean    @default(false)
  source         FoodSource @default(SYSTEM)
  userId         String?
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([name])
  @@index([barcode])
  @@index([userId])
  @@index([category])
}

enum FoodSource {
  SYSTEM
  OPEN_FOOD_FACTS
  USER_CUSTOM
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model Testimonial {
  id              String    @id @default(uuid())
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName      String
  rating          Int       @default(5)
  content         String
  highlightBadge  String?   // e.g. "🏆 +15kg Bench PR", "🔥 -6kg Lost", "⚡ 14-Day Streak"
  goal            Goal?
  isFeatured      Boolean   @default(true)
  helpfulCount    Int       @default(0)
  weightChangeKg  Float?
  durationWeeks   Int?
  verifiedAthlete Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  votes           TestimonialVote[]

  @@index([goal])
  @@index([userId])
  @@index([isFeatured])
}

model TestimonialVote {
  id            String      @id @default(uuid())
  testimonialId String
  testimonial   Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([testimonialId, userId])
  @@index([userId])
  @@index([testimonialId])
}

model DailyCheckIn {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String   // "YYYY-MM-DD" e.g. "2026-09-24"
  moodId      String   // "fire" | "strong" | "good" | "tired" | "rest"
  moodLabel   String   // "Energized", "Strong", "Balanced", "Low Energy", "Recovery"
  coachTip    String
  quote       String?
  quoteAuthor String?
  notes       String?  // Optional reflection note
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model NotificationPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealReminders      Boolean  @default(true)
  breakfastTime      String   @default("08:30")
  lunchTime          String   @default("12:30")
  dinnerTime         String   @default("19:00")
  hydrationReminders Boolean  @default(true)
  hydrationTime1     String   @default("11:00")
  hydrationTime2     String   @default("15:00")
  workoutReminders   Boolean  @default(true)
  workoutTime        String   @default("17:30")
  checkinReminders   Boolean  @default(true)
  checkinTime        String   @default("09:00")
  soundEnabled       Boolean  @default(true)
  vibrationEnabled   Boolean  @default(true)
  quietHoursEnabled  Boolean  @default(false)
  quietHoursStart    String   @default("22:00")
  quietHoursEnd      String   @default("07:00")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AiChatMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // "user" | "model"
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

model WorkoutPlan {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklySplit          Json     // { mon: "routine-id", tue: null, ... }
  routineTemplates     Json     // array of templates
  monthlySchedule      Json?    // { "2026-09-25": { routineId: "...", isRestDay: false } }
  monthlyTargetDays    Int      @default(20)
  currentMesocycleWeek Int      @default(1) // 1 to 4
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
}

model WeightLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight    Float    // kg
  date      String   // "YYYY-MM-DD" e.g. "2026-09-25"
  notes     String?  // Optional reflection note e.g. "Morning weigh-in"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model Subscription {
  id                    String             @id @default(uuid())
  userId                String             @unique
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                  SubscriptionTier   @default(FREE)
  status                SubscriptionStatus @default(ACTIVE)
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  stripePaymentIntentId String?
  amount                Float              @default(0.0)
  currency              String             @default("USD")
  interval              String?            // "month" | "year" | "lifetime"
  currentPeriodStart    DateTime           @default(now())
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([userId])
  @@index([tier])
  @@index([status])
}

enum SubscriptionTier {
  FREE
  PRO_MONTHLY
  PRO_ANNUAL
  LIFETIME_FOUNDER
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String?             @unique // null for system/platform master revenue wallet
  user         User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  isPlatform   Boolean             @default(false)
  balance      Float               @default(0.0)
  currency     String              @default("USD")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]

  @@index([userId])
}

model WalletTransaction {
  id            String            @id @default(uuid())
  walletId      String
  wallet        Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  type          TransactionType   // SUBSCRIPTION, DEPOSIT, PAYOUT, REFUND, CREDIT
  amount        Float
  currency      String            @default("USD")
  fee           Float             @default(0.0)
  netAmount     Float
  status        TransactionStatus @default(COMPLETED)
  paymentMethod String            @default("STRIPE") // "STRIPE" | "E_WALLET" | "MANUAL"
  referenceId   String?           // Stripe payment intent id or session id
  description   String
  createdAt     DateTime          @default(now())

  @@index([walletId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

enum TransactionType {
  SUBSCRIPTION
  DEPOSIT
  PAYOUT
  REFUND
  CREDIT
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
  REFUNDED
}



